# ionix-lock: the password check. Read through PamContext.configDirectory, so
# it never has to be installed into /etc/pam.d.
#
# Deliberately pam_unix alone rather than `auth include login`: that stack
# pulls in pam_faillock, which after three typos locks the account for ten
# minutes — at a lock screen that is a lockout from your own desktop, not
# protection. pam_unix's own delay after a failure still applies.
auth     required  pam_unix.so
account  required  pam_unix.so
