[Unit]
Description=Ionix Quickshell desktop shell
Documentation=https://github.com/LucasionGS/ionix-quickshell
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/qs -c ionix
ExecReload=/usr/bin/qs -c ionix ipc call theme reload
Restart=on-failure
RestartSec=2
Slice=session.slice
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_WAYLAND_DISABLE_WINDOWDECORATION=1

[Install]
WantedBy=graphical-session.target
